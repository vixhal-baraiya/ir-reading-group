---
const title = Astro.props.title ?? 'IR Reading Group';
const description = Astro.props.description ?? 'A one-page reading group overview.';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} />
    <style is:global>
      :root {
        --bg: #fff;
        --ink: #050505;
        --muted: #444;
        --line: #111;
        --link: #2f31d8;
        font-family: Arial, Helvetica, sans-serif;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-size: 18px;
        line-height: 1.42;
      }
      main {
        width: min(1240px, calc(100% - 3rem));
        margin: 0 auto;
        padding: 4.5rem 0 5rem;
      }
      h1 {
        margin: 0 0 2rem;
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        line-height: 1;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }
      p {
        max-width: 74rem;
        margin: 0 0 3.5rem;
        color: var(--ink);
        font-size: clamp(1.35rem, 2.2vw, 1.7rem);
      }
      a {
        color: var(--link);
        text-underline-offset: 0.14em;
      }
      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        font-size: clamp(1.2rem, 2vw, 1.55rem);
      }
      .search-label {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--ink);
      }
      .search-label svg { width: 1.45rem; height: 1.45rem; }
      .sort-label { white-space: nowrap; }
      .topic-list {
        border-bottom: 1px solid var(--line);
      }
      .topic-row {
        display: grid;
        grid-template-columns: 12rem minmax(0, 1fr);
        gap: 2rem;
        padding: 1.7rem 0 1.9rem;
        border-top: 1px solid var(--line);
      }
      .topic-row:first-child { border-top: 0; }
      .week {
        font-size: clamp(1.25rem, 2vw, 1.55rem);
        line-height: 1.25;
      }
      .topic h2 {
        margin: 0 0 1.1rem;
        font-size: clamp(1.35rem, 2.4vw, 1.65rem);
        line-height: 1.18;
        letter-spacing: -0.03em;
        font-weight: 500;
      }
      .topic p {
        margin: 0 0 1rem;
        max-width: 58rem;
        font-size: clamp(1.1rem, 1.8vw, 1.35rem);
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem 0.55rem;
        font-size: clamp(1.05rem, 1.7vw, 1.25rem);
      }
      .links span:not(:last-child)::after {
        content: '•';
        margin-left: 0.55rem;
        color: var(--ink);
      }
      .month-plan {
        margin-top: 3rem;
      }
      .month-plan h2 {
        margin: 0 0 1rem;
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
        text-transform: uppercase;
      }
      .lecture-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--line);
        border-left: 1px solid var(--line);
      }
      .lecture-cell {
        min-height: 5.2rem;
        padding: 0.8rem 0.9rem;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .lecture-cell span {
        display: block;
        margin-bottom: 0.25rem;
        color: var(--muted);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .lecture-cell strong {
        font-size: 1.08rem;
        font-weight: 500;
      }
      footer {
        margin-top: 2rem;
        color: var(--muted);
        font-size: 0.95rem;
      }
      /* ── Database Internals section ── */
      .db-internals {
        margin-top: 4rem;
        padding-top: 2.5rem;
        border-top: 2px solid var(--line);
      }
      .db-internals > h2 {
        margin: 0 0 0.6rem;
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
        text-transform: uppercase;
      }
      .db-intro {
        margin: 0 0 2.2rem !important;
        font-size: clamp(1.05rem, 1.7vw, 1.25rem) !important;
        color: var(--muted) !important;
      }
      .db-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
      }
      .db-card {
        background: var(--bg);
        padding: 1.4rem 1.5rem 1.6rem;
      }
      .db-card--wide {
        grid-column: 1 / -1;
      }
      .db-card h3 {
        margin: 0 0 0.9rem;
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      .db-card p {
        margin: 0 0 0.8rem;
        font-size: 1rem;
        max-width: none;
        color: var(--ink);
      }
      .db-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }
      .db-list li {
        font-size: 0.97rem;
        line-height: 1.4;
        padding-left: 1rem;
        position: relative;
      }
      .db-list li::before {
        content: '—';
        position: absolute;
        left: 0;
        color: var(--muted);
      }
      /* Flow chain */
      .flow-chain {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        margin-top: 0.5rem;
      }
      .flow-chain span {
        font-size: 0.88rem;
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--line);
        margin-right: -1px;
        margin-bottom: -1px;
        white-space: nowrap;
      }
      /* Row vs Column compare */
      .compare-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 0.4rem;
      }
      .compare-col p {
        font-size: 0.92rem !important;
        margin: 0.4rem 0 0.5rem !important;
      }
      .compare-label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.2rem 0.5rem;
        display: inline-block;
        margin-bottom: 0.5rem;
      }
      .row-label { background: #f0f0f0; color: var(--ink); }
      .col-label { background: var(--ink); color: var(--bg); }
      .examples {
        font-size: 0.82rem;
        color: var(--muted);
        letter-spacing: 0.02em;
      }
      /* Trade-off grid */
      .tradeoff-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
        margin-top: 0.5rem;
      }
      .tradeoff-item {
        background: var(--bg);
        padding: 0.7rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }
      .tradeoff-item span {
        font-size: 0.9rem;
        font-weight: 600;
      }
      .tradeoff-item em {
        font-size: 0.82rem;
        color: var(--muted);
        font-style: normal;
      }
      @media (max-width: 760px) {
        .db-grid { grid-template-columns: 1fr; }
        .compare-grid { grid-template-columns: 1fr; }
        .db-card--wide { grid-column: auto; }
      }
      @media (max-width: 760px) {
        main { width: min(100% - 2rem, 1240px); padding-top: 2.5rem; }
        .toolbar { align-items: flex-start; flex-direction: column; }
        .topic-row { grid-template-columns: 1fr; gap: 1rem; }
        .lecture-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
      <footer>Edit this page in <code>src/pages/index.astro</code>.</footer>
    </main>
  </body>
</html>
