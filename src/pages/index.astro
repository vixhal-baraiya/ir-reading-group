---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const topics = [
  {
    week: 'Week 23',
    date: 'Jun 6, 2026',
    title: 'Month 1: CS224W — Machine Learning with Graphs',
    description:
      'First month only: finish the CS224W series. Plan is 20 lecture slots, one lecture per day, and no other readings for now.',
    links: [
      { label: 'Course content', href: 'https://web.stanford.edu/class/cs224w/index.html#content' },
      { label: 'Schedule', href: 'https://web.stanford.edu/class/cs224w/index.html#schedule' },
      { label: 'Notes PDF', href: 'https://archives.leni.sh/stanford/CS224w.pdf' },
    ],
  },
];

const lectures = [
  'Introduction',
  'Node embeddings',
  'Graph neural networks',
  'General perspective on GNNs',
  'GNN augmentation and training',
  'Theory of GNNs',
  'Powerful graph encoders',
  'Graph Transformers',
  'Heterogeneous graphs',
  'Knowledge graphs',
  'GNNs for recommender systems',
  'Relational Deep Learning',
  'Advanced architectures in RDL',
  'Advanced topics in GNNs',
  'Foundation models for Knowledge Graphs',
  'LLM + GNN',
  'Agents + Graphs',
  'Deep generative models for graphs',
  'Conclusion',
  'Recap / buffer',
];

const dbNotes = await getCollection('db-internals');
const dbNotesSorted = dbNotes.sort((a, b) => a.data.chapter - b.data.chapter);
---
<Base title="IR Reading Group" description="One-page overview for the IR Reading Group.">
  <h1>IR Reading Group</h1>
  <p>
    A one-page overview of what we are reading. Month 1 is fully dedicated to Stanford CS224W,
    <em>Machine Learning with Graphs</em>.
  </p>

  <div class="toolbar" aria-label="Topic list controls">
    <div class="search-label">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-4-4"></path>
      </svg>
      <span>Search topics...</span>
    </div>
    <div class="sort-label">Oldest first</div>
  </div>

  <section class="topic-list" aria-label="Reading group topics">
    {topics.map((topic) => (
      <article class="topic-row">
        <div class="week">
          <div>{topic.week}</div>
          <div>{topic.date}</div>
        </div>
        <div class="topic">
          <h2>{topic.title}</h2>
          <p>{topic.description}</p>
          <div class="links">
            {topic.links.map((link) => (
              <span><a href={link.href}>{link.label}</a></span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="month-plan" aria-label="Month 1 lecture plan">
    <h2>Month 1 lecture plan</h2>
    <div class="lecture-grid">
      {lectures.map((lecture, index) => (
        <div class="lecture-cell">
          <span>Lecture {index + 1}</span>
          <strong>{lecture}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="db-internals" aria-label="Database Internals notes">
    <h2>Database Internals</h2>
    {dbNotesSorted.map(async (note) => {
      const { Content } = await note.render();
      return (
        <article class="db-note">
          <h3>{note.data.title}</h3>
          <div class="db-note-body">
            <Content />
          </div>
        </article>
      );
    })}
  </section>
</Base>
